# Optional: only needed for live contract extraction. Never required by make demo.
ANTHROPIC_API_KEY=
SHARK_MODEL=claude-sonnet-5-5
# The demo is a labeled historical replay so decisions remain reproducible.
SHARK_DB=.cache/refund-shark.sqlite3
SHARK_API_PORT=8000
SHARK_WEB_PORT=3000
# Seconds between vendor status checks while the API runs; make demo uses 120, 0 turns it off.
SHARK_WATCH_INTERVAL=120
# Optional: import which watched vendors a business pays from Ramp (scopes business:read transactions:read vendors:read).
RAMP_ACCESS_TOKEN=
# production or sandbox
RAMP_ENVIRONMENT=production

# Optional authenticated push integration for monitoring exports and support tickets.
# Generate a long random token locally; use the same value on the sender.
SHARK_EVIDENCE_TOKEN=

# Alert delivery stays off until explicitly enabled. Outbox previews work with no credentials.
SHARK_ENABLE_DELIVERY=0
SHARK_SMTP_HOST=
SHARK_SMTP_PORT=587
SHARK_SMTP_FROM=
SHARK_SMTP_USERNAME=
SHARK_SMTP_PASSWORD=
# Slack incoming webhook (hooks.slack.com). The URL is a secret; never put it in frontend code.
SHARK_SLACK_WEBHOOK=
SHARK_SLACK_CHANNEL_LABEL=Finance alerts

# Optional read-only Datadog integration (application key needs timeseries_query).
# Configure account-scoped metric mappings in Vendors → Datadog monitoring.
SHARK_DATADOG_API_KEY=
SHARK_DATADOG_APP_KEY=
# Seconds between automatic metric imports while the server runs; 0 disables (minimum 60).
# Each vendor must also have automatic import enabled in its saved mapping.
SHARK_MONITOR_INTERVAL=0
